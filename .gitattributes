# Keep source and documentation diffs stable across Windows/Linux checkouts.
* text=auto

*.c       text eol=lf
*.h       text eol=lf
*.S       text eol=lf
*.s       text eol=lf
*.ld      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.js      text eol=lf
*.py      text eol=lf
*.ps1     text eol=lf
*.xml     text eol=lf

*.bin     -text
*.hex     -text
*.elf     -text
*.map     -text
*.a       -text
*.o       -text
*.zip     -text
*.7z      -text
*.rar     -text
*.png     -text
*.jpg     -text
*.jpeg    -text
*.gif     -text
*.pdf     -text
